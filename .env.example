# Copy to .env and adjust. Matches the docker-compose.yml Postgres service.
# If you run a local Postgres instead of docker, point this at it (same shape).
DATABASE_URL=postgres://phobos:phobos@localhost:5432/phobos

# Tests load .env.test instead. Copy this file and change only the database
# name to phobos_test. docker-compose creates that database on first start; on
# a locally installed Postgres you must create it as a superuser (the `phobos`
# role has no CREATEDB privilege) — see README "本機 Postgres".

# Public canonical origin used by sitemap, robots, and Open Graph metadata.
# Override this for staging/production; the app falls back to https://phobos.tw.
NEXT_PUBLIC_SITE_URL=https://phobos.tw
